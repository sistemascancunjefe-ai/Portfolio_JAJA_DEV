---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import MatrixBackground from '../components/MatrixBackground.astro';
---

<Layout title="Julián Juárez | Portafolio Profesional">
  <nav class="fixed top-0 w-full z-50 bg-[#050810]/80 backdrop-blur-lg border-b border-white/5 py-4 px-8">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <a href="/" class="text-xl font-black tracking-tighter">
        <span class="text-blue-500">JAJA</span><span class="text-orange-500">.DEV</span>
      </a>
      <div class="flex gap-8 font-mono text-xs uppercase tracking-widest">
        <a href="#proyectos" class="hover:text-orange-500 transition-colors">Proyectos</a>
        <a href="#sobre-mi" class="hover:text-orange-500 transition-colors">Sobre Mí</a>
        <a href="#contacto" class="hover:text-orange-500 transition-colors">Contacto</a>
      </div>
    </div>
  </nav>

  <main class="relative">
    <MatrixBackground />
    <Hero />
    <ProjectGallery />

    <!-- More sections would go here -->
    <section id="sobre-mi" class="py-24 px-8 bg-[#050810] border-t border-white/5">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-bold mb-8">Filosofía de Trabajo</h2>
            <blockquote class="text-2xl italic text-gray-400 leading-relaxed">
                "Máquinas y sistemas al servicio de analistas, no analistas al servicio de máquinas"
            </blockquote>
        </div>
    </section>

    <footer id="contacto" class="py-24 px-8 bg-[#0a0e1a] border-t border-white/5 text-center">
        <h2 class="text-3xl font-bold mb-4">¿Listo para innovar?</h2>
        <a href="mailto:sistemascancunjefe@gmail.com.mx" class="text-gray-500 mb-8 font-mono hover:text-orange-500 transition-colors block">sistemascancunjefe@gmail.com.mx</a>
        <div class="flex justify-center gap-6">
            <a href="https://www.linkedin.com/in/julianjuarezalvarado/" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-blue-600 transition-colors">In</a>
            <a href="https://github.com/JULIANJUAREZMX01" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center hover:bg-gray-700 transition-colors">Git</a>
        </div>
        <p class="mt-12 text-[10px] text-gray-700 uppercase tracking-widest">© 2025 Julián Juárez | NEXUS Ecosystem</p>
    </footer>
  </main>
</Layout>
