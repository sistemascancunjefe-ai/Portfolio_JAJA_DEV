---
<section class="min-h-screen flex items-center justify-center pt-20 px-8 relative overflow-hidden bg-[#050810]">
  <!-- Grid Background -->
  <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#4facfe 1px, transparent 1px); background-size: 30px 30px;"></div>

  <div class="max-w-6xl w-full text-center z-10">
    <div class="inline-block px-4 py-1 rounded-full border border-orange-500/30 bg-orange-500/5 text-orange-500 font-mono text-sm mb-6 animate-fade-in">
      JEFE DE SISTEMAS & LÍDER EN AUTOMATIZACIÓN
    </div>

    <h1 class="text-6xl md:text-8xl font-black mb-8 leading-tight tracking-tighter">
      Julián Alexander <br/>
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-500 to-orange-500">Juárez Alvarado</span>
    </h1>

    <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-12 leading-relaxed">
      Transformando operaciones logísticas mediante automatización inteligente.
      Especialista en Python, JavaScript y análisis de datos con enfoque en soluciones empresariales.
    </p>

    <div class="flex flex-wrap justify-center gap-12 mb-16">
      <div class="text-center">
        <div class="text-5xl font-bold text-blue-500 mb-2">85-90%</div>
        <div class="text-gray-500 uppercase text-xs tracking-widest">Reducción de Tiempo</div>
      </div>
      <div class="text-center">
        <div class="text-5xl font-bold text-orange-500 mb-2">3,411%</div>
        <div class="text-gray-500 uppercase text-xs tracking-widest">ROI Proyectos</div>
      </div>
      <div class="text-center">
        <div class="text-5xl font-bold text-white mb-2">1,000+</div>
        <div class="text-gray-500 uppercase text-xs tracking-widest">Horas Ahorradas/Año</div>
      </div>
    </div>

    <div class="flex justify-center gap-6">
      <a href="#proyectos" class="px-8 py-4 bg-gradient-to-r from-blue-600 to-orange-600 rounded-full font-bold text-lg hover:scale-105 transition-transform">
        Ver Proyectos
      </a>
      <a href="#contacto" class="px-8 py-4 border border-white/10 rounded-full font-bold text-lg hover:bg-white/5 transition-colors">
        Contactar
      </a>
    </div>
  </div>
</section>
