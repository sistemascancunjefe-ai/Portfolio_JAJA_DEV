---
import { getEntry } from 'astro:content';

const manifesto = await getEntry('philosophy', 'manifesto');
---

<section id="manifesto" class="py-24 px-8 bg-[#0a0e1a] border-t border-white/5">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-4xl font-bold mb-8 text-center font-mono">
      <span class="text-orange-500">$</span> MANIFESTO.SH
    </h2>
    
    {manifesto && (
      <div class="bg-black/60 border-2 border-orange-500/50 p-8">
        <blockquote class="text-2xl italic text-gray-300 leading-relaxed mb-8 text-center border-l-4 border-orange-500 pl-6">
          "{manifesto.data.content}"
        </blockquote>
        
        <div class="space-y-3 font-mono">
          <div class="text-green-500 mb-4">#!/bin/bash</div>
          {manifesto.data.principles?.map((principle, index) => (
            <div class="flex items-start gap-3 text-sm">
              <span class="text-gray-600">{String(index + 1).padStart(2, '0')}.</span>
              <span class="text-gray-300">echo <span class="text-green-400">"{principle}"</span></span>
            </div>
          ))}
          <div class="text-gray-600 mt-6"># END</div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  section {
    font-family: 'Courier New', monospace;
  }
</style>
