---
import { getCollection } from 'astro:content';

const profiles = await getCollection('profile');
const profile = profiles[0];
---

<section id="terminal-profile" class="py-24 px-8 bg-[#050810] border-t border-white/5">
  <div class="max-w-5xl mx-auto">
    <div class="bg-black border-2 border-green-500/50 shadow-2xl">
      {/* Terminal Header */}
      <div class="bg-gray-900 border-b border-green-500/30 px-4 py-2 flex items-center gap-2">
        <div class="flex gap-2">
          <div class="w-3 h-3 rounded-full bg-red-500"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
          <div class="w-3 h-3 rounded-full bg-green-500"></div>
        </div>
        <span class="text-gray-500 text-xs font-mono ml-4">julian@jaja-systems:~$</span>
      </div>
      
      {/* Terminal Content */}
      <div class="p-6 font-mono text-sm space-y-2">
        {profile && (
          <>
            <div class="text-green-500">$ whoami</div>
            <div class="text-white ml-4">{profile.data.name}</div>
            <div class="text-white ml-4">{profile.data.role}</div>
            
            <div class="text-green-500 mt-4">$ cat bio.txt</div>
            <div class="text-gray-300 ml-4">{profile.data.bio}</div>
            
            <div class="text-green-500 mt-4">$ ls skills/</div>
            <div class="ml-4 grid grid-cols-2 gap-2">
              {profile.data.skills?.map((skill) => (
                <div class="text-blue-400">├── {skill}</div>
              ))}
            </div>
            
            <div class="text-green-500 mt-4">$ cat contact.json</div>
            <div class="ml-4 text-gray-300">
              <div>{'{'}</div>
              <div class="ml-4">"email": <span class="text-yellow-400">"{profile.data.email}"</span>,</div>
              <div class="ml-4">"linkedin": <span class="text-yellow-400">"{profile.data.linkedin}"</span>,</div>
              <div class="ml-4">"github": <span class="text-yellow-400">"{profile.data.github}"</span></div>
              <div>{'}'}</div>
            </div>
            
            <div class="text-green-500 mt-4 animate-blink">$ ▊</div>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    font-family: 'Courier New', monospace;
  }
</style>
