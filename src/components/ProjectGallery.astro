---
import { nexusNodes } from '../data/nexusData';
const projects = nexusNodes.filter(n => n.category === 'project');
---
<section id="proyectos" class="py-24 px-8 bg-[#0a0e1a]">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-4xl font-bold mb-16 flex items-center gap-4">
      <span class="w-12 h-1 bg-orange-500"></span>
      Proyectos de Alto Impacto
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {projects.map(project => (
        <div class="group bg-[#131824] border border-white/5 rounded-3xl p-8 hover:border-teal-500/50 transition-all duration-500 hover:shadow-[0_0_30px_rgba(20,184,166,0.1)]">
          <div class="flex justify-between items-start mb-6">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-teal-500/20 flex items-center justify-center border border-white/10">
              <span class="text-2xl font-bold text-teal-400">{project.name[0]}</span>
            </div>
            {project.id === 'a2u' && (
              <span class="px-3 py-1 bg-red-500/10 text-red-500 text-xs font-bold rounded-full border border-red-500/20">
                CLASIFICADO
              </span>
            )}
          </div>

          <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-teal-400 transition-colors">{project.name}</h3>
          <p class="text-teal-500/70 font-mono text-sm mb-4">{project.subtitle}</p>
          <p class="text-gray-400 mb-8 leading-relaxed">
            {project.description}
          </p>

          {project.metrics && (
            <div class="grid grid-cols-3 gap-4 mb-8">
              {project.metrics.map(m => (
                <div>
                  <div class="text-xl font-bold text-white">{m.value}</div>
                  <div class="text-[10px] text-gray-500 uppercase tracking-tighter">{m.label}</div>
                </div>
              ))}
            </div>
          )}

          <div class="flex flex-wrap gap-2">
            {project.techStack?.map(tech => (
              <span class="px-2 py-1 bg-white/5 text-gray-400 rounded text-xs border border-white/5">
                {tech}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
