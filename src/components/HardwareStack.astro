---
---

<section id="hardware-stack" class="py-20 px-8 bg-[#0a0e1a] border-t border-white/5">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-xs tracking-[0.3em] text-blue-500 mb-12 border-b border-white/5 pb-2 uppercase font-mono">
      // Infraestructura Física
    </h2>

    <div class="flex flex-col gap-8">
      {/* 1. NETWORKING & INFRAESTRUCTURA CRÍTICA */}
      <div class="flex flex-col md:flex-row gap-4 md:items-start group">
        <div class="md:w-1/3">
           <h3 class="text-[10px] text-slate-500 uppercase tracking-[0.2em] font-mono mb-2">01 | NETWORKING</h3>
        </div>
        <div class="md:w-2/3 space-y-3 font-mono text-xs">
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">Cisco Catalyst (L2/L3)</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Configuración de switching para videovigilancia CEDIS Cancún (Almacén 427).</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">Redes IP Industriales</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Optimización de bandwidth para 50+ cámaras IP en tiempo real.</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">IBM Power Systems</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Administración de AS/400 para entornos de producción DB2.</span>
          </div>
        </div>
      </div>

      {/* 2. TELEMETRÍA & IOT INDUSTRIAL */}
      <div class="flex flex-col md:flex-row gap-4 md:items-start group">
        <div class="md:w-1/3">
           <h3 class="text-[10px] text-slate-500 uppercase tracking-[0.2em] font-mono mb-2">02 | TELEMETRÍA & IOT</h3>
        </div>
        <div class="md:w-2/3 space-y-3 font-mono text-xs">
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">Stoneridge RI700 GPS</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Repurposing de trackers para rastreo de unidades logísticas.</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">Edge Computing</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Nodos locales para procesamiento offline-first en almacén.</span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center pl-4 border-l-2 border-slate-800 hover:border-orange-500 transition-colors duration-300">
             <span class="text-slate-300 min-w-[200px] font-bold">Sistemas de Monitoreo</span>
             <span class="text-slate-500 text-[11px] mt-1 md:mt-0">// Integración de sensores para telemetría de operaciones reales.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
