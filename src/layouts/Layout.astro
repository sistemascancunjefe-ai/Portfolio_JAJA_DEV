---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Julián Juárez | Jefe de Sistemas & Automatización" />
    <meta name="viewport" content="width=device-width" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0e1a] text-[#e8eaf0] selection:bg-orange-500 selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap');
  
  :root {
    --primary-blue: #0066B3;
    --primary-orange: #FF6600;
    --terminal-green: #00ff41;
    --bg-dark: #0a0e1a;
    --bg-darker: #050810;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  /* Monospace for specific elements */
  .font-mono, pre, code {
    font-family: 'Courier New', 'Courier Prime', monospace;
  }

  /* Custom Scrollbar - Terminal style */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #050810;
    border-left: 1px solid #00ff41;
  }
  ::-webkit-scrollbar-thumb {
    background: #00ff41;
    border-radius: 0;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #0066B3;
  }

  /* Terminal cursor animation */
  @keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  .animate-blink {
    animation: blink 1s infinite;
  }
</style>
