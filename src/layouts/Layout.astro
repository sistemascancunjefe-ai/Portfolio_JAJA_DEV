---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Julián Juárez | Jefe de Sistemas & Automatización" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0e1a] text-[#e8eaf0] selection:bg-orange-500 selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --primary-blue: #0066B3;
    --primary-orange: #FF6600;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #050810;
  }
  ::-webkit-scrollbar-thumb {
    background: #131824;
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #0066B3;
  }
</style>
